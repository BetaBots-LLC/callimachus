{
  "about": "Approximate published list prices in USD per million tokens, used by cost.rs (embedded at build time). A model id is lowercased and checked against each entry in order; the first entry with a matching equals, prefix or contains pattern wins, so a specific id (gpt-5-mini) sits above its general family (gpt-5). An entry with 'unpriced' instead of prices is a model we deliberately do not price, with the reason shown to the user. An entry with 'except' skips ids containing any of those words (a variant priced differently). An id no entry matches is counted as having no price on file. Prices are the providers' published rates (see 'sources'; 'note' says when a tier applies); a release the sources do not list falls to an unpriced entry rather than borrowing a sibling's price. Subscription plans bill differently: these are list-price equivalents, never a billing record.",
  "checked": "2026-11-07",
  "sources": {
    "openai": "https://developers.openai.com/api/docs/pricing",
    "google": "https://aistudio.google.com/docs/pricing",
    "anthropic": "https://docs.claude.com/en/docs/about-claude/pricing"
  },
  "models": [
    {
      "family": "synthetic",
      "equals": ["<synthetic>"],
      "unpriced": "not a model call (Claude Code's placeholder for a turn no model answered)"
    },
    {
      "family": "codex-unnamed",
      "equals": ["codex"],
      "unpriced": "a Codex session from before its log named the model"
    },
    {
      "family": "tool-chosen",
      "equals": ["auto", "default"],
      "unpriced": "the tool picked the model and the transcript does not say which"
    },
    {
      "family": "open-weight",
      "contains": ["gpt-oss", "llama", "gemma", "mistral", "mixtral", "devstral", "codestral", "deepseek", "kimi", "glm-", "minimax", "qwq", "qwen2", "starcoder"],
      "prefix": ["phi-", "phi3", "phi4"],
      "unpriced": "an open-weight model: its price depends on who served it, which the transcript does not record"
    },
    {
      "family": "other-provider",
      "contains": ["grok", "big-pickle"],
      "unpriced": "a provider Callimachus has no price list for"
    },

    { "family": "claude-fable", "provider": "anthropic", "contains": ["fable", "mythos"], "input": 10.0, "output": 50.0, "cacheWrite": 12.5, "cacheRead": 1.0 },
