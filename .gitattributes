# The schema drift tests (cli_contract, mcp_server) compare these files byte for byte with
# what the code generates, so a Windows checkout with core.autocrlf=true must not turn them
# into CRLF.
schemas/**/*.json text eol=lf
apps/web/public/schemas/**/*.json text eol=lf
# Committed migrations are pinned by hash (`db::migrations::tests::migration_files_are_frozen`)
# and embedded with include_str!, so a CRLF checkout must not change their bytes.
apps/desktop/src-tauri/migrations/*.sql text eol=lf
